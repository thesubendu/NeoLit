# Copy this file to .env and fill in your values.

# Required: get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6LtYvt773mLyMnpIrZ4nSH7s5HaKIjwo2kODeUhrmIMOQYOUR_KEY_HEREAQ.Ab8RN6LtYvt773mLyMnpIrZ4nSH7s5HaKIjwo2kODeUhrmIMOQ

# Optional: override the default model
GEMINI_MODEL=gemini-2.5-flash

# Optional but recommended for PubMed (raises rate limit 3 -> 10 req/s)
# Get a key at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
NCBI_EMAIL=your_email@example.com

# Optional: raises Semantic Scholar's shared rate limit
# Request one at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Optional pipeline tuning (defaults shown)
MAX_PAPERS_PER_SOURCE=15
TOP_N_FOR_EXTRACTION=12
MIN_RELEVANT_PAPERS=8
MAX_QUERY_EXPANSION_ROUNDS=2
RELEVANCE_SCORE_FLOOR=5.0
EXTRACTION_WORKERS=3
